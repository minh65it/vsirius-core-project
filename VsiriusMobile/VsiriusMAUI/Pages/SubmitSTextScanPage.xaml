<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="VsiriusMAUI.Pages.SubmitSTextScanPage"
             xmlns:vm="clr-namespace:VsiriusMAUI.ViewModels"
             x:DataType="vm:SubmitTextScanViewModel"
             Title="">
    <Grid>
        <Editor Text="{Binding .}" HeightRequest="200" />
        <ScrollView>
            <CollectionView ItemsSource="{Binding ListDescription}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Editor Text="{Binding .}" HeightRequest="200" />
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </ScrollView>
    </Grid>
</ContentPage>