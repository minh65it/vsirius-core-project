<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="VsiriusMAUI.Pages.ScanPage">
    <Grid>
        <!--<Image x:Name="CapturedImage" HeightRequest="100" Aspect="AspectFit"/>-->

        <toolkit:CameraView x:Name="MyCamera" MediaCaptured="streamCaptured"
                            HorizontalOptions="FillAndExpand"
                            VerticalOptions="FillAndExpand"/>   

        <!--<Button Text="Scan" Clicked="funcScan" Style="{StaticResource loginButton}"/>-->
        <Grid BackgroundColor="#80000000" RowDefinitions="*,*,*" ColumnDefinitions="*">
            <!-- Transparent middle area -->
            <Frame Grid.Row="1"
                   BorderColor="White"
                   BackgroundColor="Transparent"
                   HasShadow="False"
                   WidthRequest="200"
                   HeightRequest="200"
                   HorizontalOptions="Center"
                   VerticalOptions="Center" />
        </Grid>
        <StackLayout Orientation="Horizontal"
                     HorizontalOptions="FillAndExpand"
                     VerticalOptions="End"
                     Padding="10">
            <Button Text="Scan code" HorizontalOptions="FillAndExpand" />
            <Button Text="Enter code" HorizontalOptions="FillAndExpand" />
        </StackLayout>
    </Grid>
</ContentPage> 