<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="VsiriusMAUI.MainPage"
             xmlns:controls="clr-namespace:VsiriusMAUI.Pages.common"
             xmlns:vm="clr-namespace:VsiriusMAUI.ViewModels"
             x:DataType="vm:MainViewModel"
             Title="">
    <Grid>
        <VerticalStackLayout
                Padding="40,30"
                Spacing="25">
            <Image
                    x:Name="ImageShow"
                    Margin="20"
                    Source="logo.png"
                    HeightRequest="185"
                    Aspect="AspectFit"
                    SemanticProperties.Description="dot net bot in a race car number eight" />
            <Label Text="Login to your Account" FontSize="14" FontFamily="OpenSansSemibold"/>

            <Entry x:Name="email" Text="{Binding Email}" Placeholder="Email" Style="{StaticResource vInput}"/>

            <Entry x:Name="password" Text="{Binding Password}" Placeholder="Password" IsPassword="True" Style="{StaticResource vInput}"/>

            <Grid VerticalOptions="Center" HorizontalOptions="Start" ColumnDefinitions="Auto, *" Padding="0" Margin="0">

                <CheckBox x:Name="CheckboxShowpassword"   Grid.Column="0"  Margin="0" CheckedChanged="CheckedCheckBox"/>

                <Label Grid.Column="1" Text="Show password" VerticalOptions="Center" HorizontalOptions="Start" Margin="0" />
            </Grid>

            <Button  x:Name="SignIn" Text="Sign in" HorizontalOptions="Fill" BackgroundColor="#ff8e00" Style="{StaticResource loginButton}" Command="{Binding Loggin}"/>
        </VerticalStackLayout>
    </Grid>
</ContentPage>




