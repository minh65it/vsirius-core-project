<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="VsiriusMAUI.Pages.UploadPage"
             xmlns:vm="clr-namespace:VsiriusMAUI.ViewModels">

    <ContentPage.BindingContext>
        <vm:UploadViewModel />
    </ContentPage.BindingContext>
    

    <Grid Padding="40, 30" >
        <StackLayout Grid.Row="0" Spacing="10">
            <Grid HorizontalOptions="Center">
                <Grid.RowDefinitions >
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Frame Grid.Row="0" Grid.Column="0"  WidthRequest="110" HeightRequest="110" Margin="10">
                    <Image Source="addicon.png" Aspect="AspectFill" HorizontalOptions="Center" VerticalOptions="Center">
                        <Image.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding AddImageCommand}" />
                        </Image.GestureRecognizers>
                    </Image>
                </Frame>

                <Frame Grid.Row="0" Grid.Column="1" WidthRequest="110" HeightRequest="110" Margin="10">
                    <Image Source="addicon.png" Aspect="AspectFill" HorizontalOptions="Center" VerticalOptions="Center">
                        <Image.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding AddImageCommand}" />
                        </Image.GestureRecognizers>
                    </Image>
                </Frame>

                <Frame Grid.Row="1" Grid.Column="0" WidthRequest="110" HeightRequest="110" Margin="10">
                    <Image Source="addicon.png" Aspect="AspectFill" HorizontalOptions="Center" VerticalOptions="Center">
                        <Image.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding AddImageCommand}" />
                        </Image.GestureRecognizers>
                    </Image>
                </Frame>

                <Frame Grid.Row="1" Grid.Column="1" WidthRequest="110" HeightRequest="110" Margin="10">
                    <Image Source="addicon.png" Aspect="AspectFill" HorizontalOptions="Center" VerticalOptions="Center">
                        <Image.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding AddImageCommand}" />
                        </Image.GestureRecognizers>
                    </Image>
                </Frame>
            </Grid>

            <Picker ItemsSource="{Binding Options}" SelectedItem="{Binding SelectedOption}" Title="Select an option"  HeightRequest="70"/>
            <Label Text="Notes" />
            <Editor Placeholder="Enter notes here" HeightRequest="200" />


        </StackLayout>
        <Button Text="Submit" HorizontalOptions="Fill" Background="#ff8e00" VerticalOptions="End" />
    </Grid>
</ContentPage>

    
    