<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:VsiriusMAUI.Pages.common"
             x:Class="VsiriusMAUI.Pages.UploadPage"
             xmlns:vm="clr-namespace:VsiriusMAUI.ViewModels"
             x:DataType="vm:UploadViewModel">
    <Grid>
        <Grid Padding="40, 30">
            <StackLayout Grid.Row="0" Spacing="10">
                <Grid HorizontalOptions="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Frame Grid.Row="0" Grid.Column="0" WidthRequest="180" HeightRequest="180" Margin="10" Padding="0">
                        <StackLayout>
                            <Image Source="{Binding Path1}" Aspect="AspectFill" HorizontalOptions="Center" VerticalOptions="Center">
                                <Image.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding UploadImage}" CommandParameter="0"/>
                                </Image.GestureRecognizers>
                            </Image>
                            <Image Source="addicon.png" Aspect="AspectFill" IsVisible="{Binding IsImageNull1}" HorizontalOptions="Center" VerticalOptions="Center">
                                <Image.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding UploadImage}" CommandParameter="0"/>

                                </Image.GestureRecognizers>
                            </Image>
                        </StackLayout>
                    </Frame>

                    <!--<Frame Grid.Row="0" Grid.Column="1" WidthRequest="110" HeightRequest="110" Margin="10" Padding="0">
                        <StackLayout>
                            <Image Source="{Binding Path2}" Aspect="AspectFill" HorizontalOptions="Center" VerticalOptions="Center">
                                <Image.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding UploadImage}" CommandParameter="1"/>
                                </Image.GestureRecognizers>
                            </Image>
                            <Image Source="addicon.png" Aspect="AspectFill" IsVisible="{Binding IsImageNull2}" HorizontalOptions="Center" VerticalOptions="Center">
                                <Image.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding UploadImage}" CommandParameter="1"/>
                                </Image.GestureRecognizers>
                            </Image>
                        </StackLayout>
                    </Frame>

                    <Frame Grid.Row="1" Grid.Column="0" WidthRequest="110" HeightRequest="110" Margin="10" Padding="0">
                        <StackLayout>
                            <Image Source="{Binding Path3}" Aspect="AspectFill" HorizontalOptions="Center" VerticalOptions="Center">
                                <Image.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding UploadImage}" CommandParameter="2"/>
                                </Image.GestureRecognizers>
                            </Image>
                            <Image Source="addicon.png" Aspect="AspectFill" IsVisible="{Binding IsImageNull3}" HorizontalOptions="Center" VerticalOptions="Center">
                                <Image.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding UploadImage}" CommandParameter="2"/>
                                </Image.GestureRecognizers>
                            </Image>
                        </StackLayout>
                    </Frame>

                    <Frame Grid.Row="1" Grid.Column="1" WidthRequest="110" HeightRequest="110" Margin="10" Padding="0">
                        <StackLayout>
                            <Image Source="{Binding Path4}" Aspect="AspectFill" HorizontalOptions="Center" VerticalOptions="Center">
                                <Image.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding UploadImage}" CommandParameter="3"/>
                                </Image.GestureRecognizers>
                            </Image>
                            <Image Source="addicon.png" Aspect="AspectFill" IsVisible="{Binding IsImageNull4}" HorizontalOptions="Center" VerticalOptions="Center">
                                <Image.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding UploadImage}" CommandParameter="3"/>
                                </Image.GestureRecognizers>
                            </Image>
                        </StackLayout>
                    </Frame>-->
                </Grid>
                <Label Text="Document type" />
                <Picker ItemsSource="{Binding Options}" SelectedItem="{Binding SelectedOption}" HeightRequest="55"/>
                <Label Text="Notes" />
                <Editor Text="{Binding Note}" Placeholder="Enter notes here" HeightRequest="200" />
            </StackLayout>

            <Button Text="Submit" HorizontalOptions="Fill" Background="#ff8e00" VerticalOptions="End" Command="{Binding UploadData}"/>

        </Grid>
        <controls:LoadingPage IsVisible="{Binding IsVisibleLoadingPage}" />
    </Grid>
</ContentPage>



