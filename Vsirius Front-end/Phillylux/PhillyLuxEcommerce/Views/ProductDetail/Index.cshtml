                                           data-toggle="modal"
                                           data-target="#heart_model"><i class="fa fa-heart heart-red"></i><span>Remove To Wishlist</span></a>
                                    </span>
                                }
                                else
                                {
                                    <span class="sp_comp1">
                                        <a id="heartIcon-@Model.SKU"
                                           href="#" data-productId="@Model.SKU"
                                           class="symbol pro_heart font-weight-bolder text-uppercase wishlist-load home-link"
                                           data-toggle="modal"
                                           data-target="#heart_model"><i class="fa fa-heart"></i><span>Add To Wishlist</span></a>
                                    </span>
                                }
