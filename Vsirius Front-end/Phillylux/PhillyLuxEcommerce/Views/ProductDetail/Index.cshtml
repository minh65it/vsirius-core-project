                            <label class="btn size_ rounded">
                            <input class="" type="radio" name="options" />L
                            </label>
                            </li>
                            </ul>
                            </div>*@

                            <div class="sp_counter mt-4">
                                <div class="sp_c_count1">
                                    <div class="number">
                                        <!-- <span class="minus">-</span>
                                        <input type="text" value="1"/>
                                        <span class="plus">+</span> -->
                                        <div class="sp_counter">
                                            <div class="input-group">
                                                <span class="input-group-btn">
                                                    <button type="button"
                                                            class="btn btn-default btn-number p-0"
                                                            disabled="disabled"
                                                            data-type="minus"
                                                            data-field="quant[1]">
                                                        <span class="minus">-</span>
                                                    </button>
                                                </span>
                                                <input type="number" id="productQty"
                                                       name="quant[1]"
                                                       class="form-control input-number"
                                                       value="1"
                                                       min="1"
                                                       max="10" />
                                                <span class="input-group-btn">
                                                    <button type="button"
                                                            class="btn btn-default btn-number p-0"
                                                            data-type="plus"
                                                            data-field="quant[1]">
                                                        <span class="plus">+</span>
                                                    </button>
                                                </span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <span class="sp_c_count2">
                                    <a id="btnAddCart" class="btn btn-primary primary"
                                       data-toggle="modal" data-target="#cart_model">
                                        add to cart
                                    </a>
                                </span>
                            </div>

                            <div class="sp_about my-3">
                                <span class="sp_comn1">
                                    <a href="#"
                                       class="font-weight-bolder home-link"
                                       data-toggle="modal"
                                       data-target="#shippingModal"><i class="fas fa-box-open"></i>shipping</a>
                                </span>
                               
                            <div class="sp_buy my-3">
                                <form id="buyItNow" action="/Payment">
                                    <button type="submit" onclick="btnBuyItNow()" class="btn btn-primary primary">
                                        buy it now
                                    </button>
                                </form>
                            </div>
