@model ProductDetailVM

<style>
    .heart-red {
        color: red;
    }
</style>
<!-- single product header area -->
<div id="single_product"
     class="single_product_page animate__animated animate__fadeInUp">
    <div class="sp_header bg-white">
        <div class="container custom_container bg-white">
            <div class="row ">
                <div class="col-12 ">
                    <ul class="p-md-3 p-2">
                        <li class="d-inline-block font-weight-bolder"><a class="home-link" asp-controller="Home" asp-action="Index">home</a></li>
                        <li class="d-inline-block hr_ font-weight-bolder">/</li>
                        <li class="d-inline-block hr_ font-weight-bolder">
                            <a class="home-link" href="#">category</a>
                        </li>
                        <li class="d-inline-block hr_ font-weight-bolder">/</li>
                        <li class="d-inline-block hr_ font-weight-bolder">@Model.ItemType</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>

    <div class="sp_header bg-white">
        <div class="container sp_pro_container custom_container pt-2">
            <div class="row sh_page bg-white rounded border py-2">
                <div class="col-xl-4 col-lg-6 col-md-6 col-12 sp_left_product px-2">
                    <div id="content" class="page-content">
                        <div class="row">
                            <div class="col-lg-12 col-md-12 col-sm-12 col-12 sp_zoom_pro mb-5">
                                @*<img id="zoom_03"
                                src="~/img/product/placeholder.jpg"
                                class="rounded img-fluid js-product-cover"
                                data-zoom-image="img/product/placeholder.jpg" />*@

                                <img id="zoom_03"
                                     src="@Model.main_image_url"
                                     class="rounded img-fluid js-product-cover" style="max-width:95%"
                                     data-zoom-image="@Model.main_image_url" />
                            </div>
                            <div class="col-lg-12 col-md-12 col-sm-12 col-12 sp_muti_pro">
                                <div id="gallery_02" class="row owl-carousel owl-theme">
                                    @{
                                        var imageUrls = new List<string>
                                        {
                                            Model.main_image_url,
                                            Model.other_image_url1,
                                            Model.other_image_url2,
                                            Model.other_image_url3,
                                            Model.other_image_url4,
                                            Model.other_image_url5,
                                            Model.other_image_url6,
                                            Model.other_image_url7,
                                            Model.other_image_url8
                                        };

                                        foreach (var imageUrl in imageUrls.Where(url => !string.IsNullOrWhiteSpace(url)))
                                        {
                                            var imageGallery = new ImageGalleryVM { imageUrl = imageUrl };
                                            <partial name="_ImageGallery" for="@imageGallery" />
                                        }
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-xl-8 col-lg-6 col-md-6 col-12 sp_right_product pl-lg-3 pl-2 pr-2">
                    <div class="sp_ri_leftpart">
                        <div class="sp_product_detail">
                            <h1 class="font-weight-bolder">
                                @Model.Title
                            </h1>
                            <span class="sp_price font-weight-bold">$@Model.Price</span>
                            <div class="text-secondary sp_tax">Tax included.</div>
                            <div class="sp_add_info">
                                <ul>
                                    <li class="sku my-2">
                                        <span class="text-uppercase font-weight-bolder tags-title">sku:</span>
                                        <span id="sku">@Model.SKU</span>
                                    </li>
                                    <li class="availability my-2">
                                        <span class="font-weight-bolder tags-title">Availability:</span>
                                        <span class="p_quantity">@Model.Quantity</span>
                                        <span>in stock</span>
                                    </li>
                                </ul>
                            </div>
                            <div class="sp_rating">
                                <i class="fa fa-star" aria-hidden="true"></i>
                                <i class="fa fa-star" aria-hidden="true"></i>
                                <i class="fa fa-star" aria-hidden="true"></i>
                                <i class="fa fa-star" aria-hidden="true"></i>
                                <i class="fa fa-star" aria-hidden="true"></i>
                            </div>
                            <div class="sp_text">
                                <ul>
                                    @{
                                        if (!string.IsNullOrWhiteSpace(Model.BulletPoints))
                                        {
                                            foreach (var item in Model.BulletPoints.Split("|"))
                                            {
                                                if (!string.IsNullOrWhiteSpace(item))
                                                {
                                                    <li class="my-2">
                                                        <strong>-</strong> @item
                                                    </li>
                                                }
                                            }
                                        }
                                    }

                                </ul>
                            </div>


                            @*<div id="clockdiv" class="sp_clockdiv">
                            <div class="main_box rounded">
                            <span class="days"></span>
                            <div class="smalltext">Day</div>
                            </div>
                            <div class="main_box rounded">
                            <span class="hours"></span>
                            <div class="smalltext">Hour</div>
                            </div>
                            <div class="main_box rounded">
                            <span class="minutes"></span>
                            <div class="smalltext">Min</div>
                            </div>
                            <div class="main_box rounded">
                            <span class="seconds"></span>
                            <div class="smalltext">Sec</div>
                            </div>
                            </div>*@
                            @*<div class="sp_color my-4">
                            <ul>
                            <li class="font-weight-bold text-uppercase my-2">color:</li>
                            <li class="btn-group btn-group-toggle my-2"
                            data-toggle="buttons">
                            <label class="btn yellow rounded active">
                            <input class="" type="radio" name="options" />
                            </label>
                            <label class="btn black rounded">
                            <input class="" type="radio" name="options" />
                            </label>
                            </li>
                            </ul>
                            </div>*@
                            @*<div class="sp_size">
                            <ul>
                            <li class="font-weight-bold text-uppercase my-2">size:</li>
                            <li class="btn-group btn-group-toggle my-2"
                            data-toggle="buttons">
                            <label class="btn size_ rounded active">
                            <input class="" type="radio" name="options" />S
                            </label>
