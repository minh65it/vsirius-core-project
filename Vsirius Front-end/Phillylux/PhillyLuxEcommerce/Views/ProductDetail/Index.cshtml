    <!-- single product img and detail -->
    <!-- related product -->
    <div class="sp_header bg-white">
        <div class="container custom_container t_pro_container fadeInUp">
            <div class="row">
                <div class="col-12">
                    <div class="title_outer">
                        <h5 class="font-weight-bolder mb-4 d-inline-block">
                            related products
                        </h5>
                    </div>
                    <!-- title_outer -->
                </div>
                <!-- col-12 -->
            </div>
            <!-- row -->
            <div class="sp_header bg-white">
                <div class="row">
                    @{
                        if (Model.RelatedProducts != null)
                        {
                            if (Model.RelatedProducts.Count() > 0)
                            {
                                <div id="related_product_carousel"
                                     class="srelated_product_carousel owl-carousel owl-theme pro_thumb">

                                    @foreach (var item in Model.RelatedProducts)
                                    {
                                        <div class="item">
                                            <div class="col-12 no-padding-x">
                                                <div class="product_thumb bg-yellow-custom rounded">
                                                    <div class="pro_image">
                                                        <a asp-controller="ProductDetail" asp-action="Index" asp-route-productId="@item.ProductId">
                                                            <img src="@item.MainImageUrl"
                                                                 class="fst-image mx-auto d-block img-fluid"
                                                                 alt="placeholder" />
                                                        </a>
                                                        <a asp-controller="ProductDetail" asp-action="Index" asp-route-productId="@item.ProductId">
                                                            <img src="@item.SubImageUrl"
                                                                 class="second-img mx-auto d-block img-fluid"
                                                                 alt="placeholder" />
                                                        </a>
                                                    </div>
                                                    <div class="text-center">
                                                        <div class="button-group">
                                                            @if (item.CheckWishlist == true)
                                                            {
                                                                <a class="symbol pro_heart delete-wishlist-link wishlist-active" data-productId="@item.ProductId" data-idWishlist="@item.WishListId.ToString()" data-toggle="modal" data-target="#heart_model"></a>
                                                            }
                                                            else
                                                            {
                                                                <a class="symbol pro_heart add-wishlist-link" data-productId="@item.ProductId" data-toggle="modal" data-target="#heart_model"></a>
                                                            }
                                                            <a href="#"
                                                               class="symbol pro_eye"
                                                               data-toggle="modal"
                                                               data-target="#eye_model"
                                                               onclick="getModalDataProduct('@item.ProductId', '@item.ProductName', '@item.Price', '@item.ProductDescription', '@item.MainImageUrl');"></a>
                                                            <a href="#"
                                                               class="symbol pro_compare"
                                                               data-toggle="modal"
                                                               data-target="#compare_model "></a>
                                                        </div>

                                                        <div class="main_text">
                                                            <h2 class="text-center pro-heading my-2">
                                                                <a class="item-product" asp-controller="ProductDetail" asp-action="Index" asp-route-productId="@item.ProductId" class="font-weight-bolderer">@item.ProductName</a>
                                                            </h2>
                                                            <div class="star">

                                                                @if (item.CheckWishlist == true)
                                                                {
                                                                    <i id="heartIcon-@item.ProductId" class="fa fa-heart heart-blue iconVisible"></i>
                                                                }
                                                                else
                                                                {
                                                                    <i id="heartIcon-@item.ProductId" class="fa fa-heart heart-blue iconHidden"></i>
                                                                }

                                                                <i class="fa fa-star" aria-hidden="true"></i>
                                                                <i class="fa fa-star" aria-hidden="true"></i>
                                                                <i class="fa fa-star" aria-hidden="true"></i>
                                                                <i class="fa fa-star" aria-hidden="true"></i>
                                                                <i class="fa fa-star" aria-hidden="true"></i>

                                                                @if (item.CheckCart == true)
                                                                {
                                                                    <i id="cartIcon-@item.ProductId" class="fa fa-shopping-cart cart-blue iconVisible"></i>
                                                                }
                                                                else
                                                                {
                                                                    <i id="cartIcon-@item.ProductId" class="fa fa-shopping-cart cart-blue iconHidden"></i>
                                                                }

                                                            </div>
                                                            <span class="text-center prices">
                                                                @{
                                                                    if (!string.IsNullOrWhiteSpace(item.SalePrice))
                                                                    {
                                                                        <span class="font-weight-bolder price">$@item.SalePrice </span>
                                                                        <del class="text-muted">$@item.Price</del>
                                                                    }
                                                                    else
                                                                    {
                                                                        <span class="font-weight-bolder price">$@item.Price</span>
                                                                    }
                                                                }
                                                            </span>
                                                            <a href="#"
                                                               onclick="addToCart('@item.ProductId',1)"
                                                               class="symbol add_to_cart"
                                                               data-toggle="modal" data-target="#cart_model">
                                                                + ADD TO CART
                                                            </a>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        }
                    }
                    <!-- product_carousel2 -->
                </div>
            </div>
        </div>
        <!-- related product end -->
        <!-- product descr-->
        <div class="sp_header bg-white">
            <div class="container custom_container t_pro_container">
                <div class="row">
                    <div class="col-12">
                        <div class="title_outer text-left">
                            <h5 class="font-weight-bolder mb-4 d-inline-block">
                                product description
                            </h5>
                        </div>
                        <!-- title_outer -->
                    </div>
                    <!-- col-12 -->
                </div>
                <!-- row -->
                <div class="row mx-0 pb-3">

                    @Html.Raw(Model.Description)
                </div>
            </div>
        </div>
        <!-- product descr end -->
        <!-- custom product -->
        <div class="test">
         
        </div>
    </div>
</div>
