        async function btnBuyItNow() {
            var productQtyInput = document.getElementById('productQty');
            var skuInput = document.getElementById('sku');


            var response = await buyItNow(skuInput.textContent, productQtyInput.value)
            if (respose.success) {
                document.getElementById('buyItNow').submit();
            }
        }

        async function buyItNow(itemsku, quantity) {
            try {

                let url = `/ProductDetail/BuyItNow?productId=${itemsku}&quantity=${quantity}`;

                let response = await fetch(url, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    }
                });

                if (response.ok) {
                    return { success: true };
                }
                else {
                    return { success: false };
                }
            } catch (error) {
                console.log(error)
                return { success: false };
            }
        }
