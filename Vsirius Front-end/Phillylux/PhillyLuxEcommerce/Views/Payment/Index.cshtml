                                <div class="row">
                                    <div class="col-sm-4 col-xs-12 mb-3">
                                        @if (string.IsNullOrEmpty(@item.main_image_url))
                                        {
                                            <img src="~/img/no-photo/no-photo_800x800.png"
                                                 class="fst-image mx-auto d-block img-fluid border rounded productImage"
                                                 alt="placeholder" />
                                        }
                                        else
                                        {
                                            <img src="@($"{item.main_image_url}")"
                                                 class="fst-image mx-auto d-block img-fluid border rounded productImage"
                                                 alt="category" />
                                        }
                                    </div>
                                    <div class="col-sm-8 col-xs-12">
                                        <h6 class="font-weight-bolder" id="">@item.ProductName</h6>
                                        <div class="font-weight-bolder pb-1" id="">#@item.SKU</div>
                                        @*<div class="font-weight-bolder" id="">$@item.Price</div>*@
                                        @if (string.IsNullOrEmpty(item.PriceSale))
                                        {
                                            <span class="font-weight-bolder price">
                                                $@item.Price
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="font-weight-bolder price">
                                                $@item.PriceSale
                                            </span>
                                            <del class="text-muted">$@item.Price </del>
                                        }
                                        <div>
                                            <span class="f_13 pb-1">Size: </span>
                                            <span class="float-right" style="margin-right: 1rem">@item.Size</span>
                                        </div>
                                        <div>
                                            <span class="f_13 pb-1">Color: </span>
                                            <span class="float-right" style="margin-right: 1rem">@item.Color</span>
                                        </div>

                                        <div>
                                            <span class="f_13 pb-1">Qty: </span>
                                            <span class="float-right" style="margin-right: 1rem">@item.QuantityItem</span>
                                        </div>

                                    </div>
                                </div>
                                <hr />
                            }
                        </div>
                        <div class="card-body  border-bottom">

                            <p class="text-muted" style="font-size: 14px;">@Model.OrderCart.QuantityTotalItem items</p>
                            <p class="font-weight-bolderer">show details</p>
                            <div style="font-size: 16px;">
                                <span class="font-weight-bolder">subtotal</span>
                                <span class="float-right font-weight-bolder">$@Model.OrderCart.TotalPrice</span>
                            </div>
                            <div style="margin-top: 15px; font-size: 16px;">
                                <span class="font-weight-bolder">shipping</span>
                                <span class="float-right font-weight-bolder">Free</span>
                            </div>
                        </div>
                        <div class="card-body ">
                            <div style="font-size: 16px;">
                                <span class="font-weight-bolder">taxes</span>
                                <span class="float-right font-weight-bolder">$@Model.OrderCart.Tax</span>
                            </div>
                            <div style="font-size: 16px;">
                                <span class="font-weight-bolder">total(tax excl.)</span>
                                <span class="float-right font-weight-bolder">$@Model.OrderCart.TotalPrice</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

}

<!-- checkout page -->

@section Scripts{
    <script type="text/javascript">
        $(document).ready(function () {
            $(document).on('change', '#country', function (e) {
                $('#state').empty();

                let country = $(this).val();
                if (country === 'Canada') {
                    let stateList = @Html.Raw(stateListCanadaJson);
                    stateList.forEach(function (state) {
                        $('#state').append('<option value="' + state.Key + '">' + state.Title + '</option>');
                    });
                } else {
                    let stateList = @Html.Raw(stateListUSAJson);
                    stateList.forEach(function (state) {
                        $('#state').append('<option value="' + state.Key + '">' + state.Title + '</option>');
                    });
                }
            });
        });

        window.addEventListener('load', function () {
            var messageCardNumberDiv = document.getElementById("messageCardNumber");
            var messageExpiredDateDiv = document.getElementById("messageExpiredDate");

            if (messageCardNumberDiv != null) {
                if (messageCardNumberDiv.innerText.trim() !== "") {
                    openBtnPaymentValidate()
                }
            }

            if (messageExpiredDateDiv != null) {
                if (messageExpiredDateDiv.innerText.trim() !== "") {
                    openBtnPaymentValidate()
                }
            }

        });

        function openBtnPaymentValidate() {
            var checkPaymentDiv = document.getElementById("payment");
            var checkInfoDiv = document.getElementById("info");

            checkInfoDiv.classList.remove("collapse", "show");
            checkInfoDiv.classList.add("collapse");

            checkPaymentDiv.classList.remove("collapsing");
            checkPaymentDiv.classList.add("collapse");
        }

        var checkBox = document.getElementById('user_pay_check');
        checkBox.addEventListener('change', checkBoxPolicy);

        const submitBtnOrder = document.getElementById('submit_btnOrder');
        const submitBtnInformation = document.getElementById('submit_btnInformation');
        const submitBtnAddress = document.getElementById('submit_btnAddress');
        const submitBtnPayment = document.getElementById('submit_btnPayment');

        submitBtnOrder.addEventListener('click', function (event) {
            event.preventDefault();
            if (validateFormInformation()) {
                if (validateFormAddress()) {
                    if (validateFormPayment()) {
                        if (checkBoxPolicy()) {
                            let form = document.getElementById('orderForm');
                            HTMLFormElement.prototype.submit.call(form);
                        }
                    }
                }
            }
        });

        submitBtnInformation.addEventListener('click', function (event) {
            event.preventDefault();
            var checkInfoDiv = document.getElementById("info");
            var checkAddDiv = document.getElementById("add");
            var checkPaymentDiv = document.getElementById("payment");

            var isCollapsed = checkInfoDiv.classList == "collapse show";
            if (!isCollapsed) {
                checkInfoDiv.classList.add("collapse", "show");

                checkAddDiv.classList.remove("collapse", "show");
                checkAddDiv.classList.add("collapse");

                checkPaymentDiv.classList.remove("collapse");
                checkPaymentDiv.classList.add("collapsing");
            }
        });

        submitBtnAddress.addEventListener('click', function (event) {
            event.preventDefault();
            var checkInfoDiv = document.getElementById("info");
            var checkAddDiv = document.getElementById("add");
            var checkPaymentDiv = document.getElementById("payment");


            if (!validateFormInformation()) {
                checkAddDiv.classList.remove("collapse", "show");

                checkAddDiv.classList.add("collapse");
                checkInfoDiv.classList.add("collapse", "show");

            }
            else {
                checkInfoDiv.classList.remove("collapse", "show");
                checkInfoDiv.classList.add("collapse");

                checkAddDiv.classList.add("collapse", "show");

                checkPaymentDiv.classList.remove("collapse");
                checkPaymentDiv.classList.add("collapsing");
            }
        });

        submitBtnPayment.addEventListener('click', function (event) {
            event.preventDefault();
            var checkPaymentDiv = document.getElementById("payment");
            var checkAddDiv = document.getElementById("add");
            var checkInfoDiv = document.getElementById("info");

            if (!validateFormAddress()) {
                if (!validateFormInformation()) {
                    checkPaymentDiv.classList.remove("collapse");

                    checkPaymentDiv.classList.add("collapsing");
                    checkInfoDiv.classList.add("collapse", "show");
                }
                else {
                    checkPaymentDiv.classList.remove("collapse");
                    checkPaymentDiv.classList.add("collapsing");

                    checkInfoDiv.classList.remove("collapse", "show");
                    checkInfoDiv.classList.add("collapse");

                    checkAddDiv.classList.add("collapse", "show");
                }
            }
            else {
                if (validateFormInformation()) {
                    checkAddDiv.classList.remove("collapse", "show");
                    checkAddDiv.classList.add("collapse");

                    checkInfoDiv.classList.remove("collapse", "show");
                    checkInfoDiv.classList.add("collapse");

                    checkPaymentDiv.classList.remove("collapsing");
                    checkPaymentDiv.classList.add("collapse");
                }
            }
        });

        function checkBoxPolicy() {
            var checkBox = document.getElementById('user_pay_check');
            var validate = document.querySelector('.checkbox-validate');

            if (checkBox.checked) {
                validate.style.display = 'none';
                return true;
            } else {
                validate.textContent = 'Please accept the Terms of Use & Privacy Policy';
                validate.style.display = 'block';
                return false;
            }
        }

        function formatPostCodeNumber(input) {
            const countryInput = document.getElementById('country');

            const selectedCountry = countryInput.value;
            if (selectedCountry === "United States") {
                let formattedValue = input.value.replace(/\D/g, '');
                formattedValue = formattedValue.slice(0, 5);
                input.value = formattedValue;
            } else if (selectedCountry === "Canada") {
                const formattedValue = input.value.replace(/\W/g, '');
                if (formattedValue.length > 6) {
                    input.value = formattedValue.slice(0, 6).replace(/(\w{3})(\w{3})/, '$1 $2');
                } else {
                    input.value = formattedValue;
                }
            }
        }

        function formatPaymentNumber(input) {
            input.value = input.value.replace(/\D/g, '');
        }

        function formatPhoneNumber(input) {
            input.value = input.value.replace(/\D/g, '');

            if (input.value.length > 10) {
                input.value = input.value.slice(0, 10);
            }
        }

        function validateFormInformation() {
            let isValid = true;

            //const firstNameInput = document.getElementById('f_name');
            //const lastNameInput = document.getElementById('l_name');
            const fullName = document.getElementById('full_name');
            const emailInput = document.getElementById('r_email');
            const phoneInput = document.getElementById('r_phone');

            const birthdayInput = document.getElementById('birthday');

            //if (!isFieldValid(firstNameInput)) {
            //    isValid = false;
            //}

            //if (!isFieldValid(lastNameInput)) {
            //    isValid = false;
            //}

            if (!isFieldValid(fullName)) {
                isValid = false;
            }

            if (!isEmailValid(emailInput)) {
                isValid = false;
            }

            if (!isPhoneNumberValid(phoneInput)) {
                isValid = false;
            }

            return isValid;
        }

        function validateFormAddress() {
            let isValid = true;

            const addressInput = document.getElementById('address1');
            const cityInput = document.getElementById('city');
            const stateInput = document.getElementById('state');
            const postcodeInput = document.getElementById('postcode');
            const countryInput = document.getElementById('country');

            if (!isFieldValid(addressInput)) {
                isValid = false;
            }

            if (!isPostcode(postcodeInput)) {
                isValid = false;
                console.log("failed")
            }

            if (!isFieldValid(countryInput)) {
                isValid = false;
            }

            return isValid;
        }

        function validateFormPayment() {
            let isValid = true;

            const cardnumberInput = document.getElementById('cardnumber');
            const expirationDateMonthInput = document.getElementById('expirationDateMonth');
            const expirationDateYearInput = document.getElementById('expirationDateYear');
            const CCVInput = document.getElementById('CCV');

            if (!isCardNumberValid(cardnumberInput)) {
                isValid = false;
            }

            if (!isExDateValid(expirationDateMonthInput)) {
                isValid = false;
            }

            if (!isCardCodeValid(CCVInput)) {
                isValid = false;
            }

            return isValid;
        }

        function isFieldValid(field) {
            let value = field.value.trim();
            let validate = field.nextElementSibling;

            field.addEventListener("input", function () {
                value = field.value.trim();
                if (value) {
                    validate.style.display = "none";
                }
                else {
                    validate.textContent = "Please enter a value";
                    validate.style.display = "block";
                }
            });

            if (!value) {
                validate.textContent = "Please enter a value";
                validate.style.display = "block";
                return false;
            } else {
                validate.style.display = "none";
                return true;
            }
        }

        function isEmailValid(emailInput) {
            let email = emailInput.value.trim();
            let validate = emailInput.nextElementSibling;
            let emailRegex = /\S+@@\S+\.\S+/;

            emailInput.addEventListener("input", function () {
                email = emailInput.value.trim();
                if (email) {
                    if (!emailRegex.test(email)) {
                        validate.textContent = "Please Enter a valid Email";
                        validate.style.display = "block";
                    } else {
                        validate.style.display = "none";
                    }
                }
                else {
                    validate.textContent = "Please Enter your Email";
                    validate.style.display = "block";
                }
            });

            if (email) {
                if (!emailRegex.test(email)) {
                    validate.textContent = "Please Enter a valid Email";
                    validate.style.display = "block";
                    return false;
                } else {
                    validate.style.display = "none";
                    return true;
                }
            } else {
                validate.textContent = "Please Enter your Email";
                validate.style.display = "block";
                return false;
            }
        }

        function isPhoneNumberValid(phoneInput) {
            let phoneNumber = phoneInput.value.trim();
            let validate = phoneInput.nextElementSibling;
            let phoneRegex = /^\d{10}$/;

            phoneInput.addEventListener("input", function () {
                phoneNumber = phoneInput.value.trim();
                if (phoneNumber) {
                    if (phoneRegex.test(phoneNumber)) {
                        validate.style.display = "none";
                    } else {
                        validate.textContent = "Please enter a 10-digit phone number";
                        validate.style.display = "block";
                    }
                }
                else {
                    validate.textContent = "Please Enter your Phone";
                    validate.style.display = "block";
                }
            });

            if (phoneNumber) {
                if (phoneRegex.test(phoneNumber)) {
                    validate.style.display = "none";
                    return true;
                } else {
                    validate.textContent = "Please enter a 10-digit phone number";
                    validate.style.display = "block";
                    return false;
                }

            } else {
                validate.textContent = "Please Enter your Phone";
                validate.style.display = "block";
                return false;
            }
        }

        function isCityValid(cityInput) {

            let city = cityInput.value.trim();
            let validate = cityInput.nextElementSibling;
            let cityRegex = /^[a-zA-Z]+(?:[\s-][a-zA-Z]+)*$/;

            cityInput.addEventListener("input", function () {
                city = cityInput.value.trim();
                if (city) {
                    if (cityRegex.test(city)) {
                        validate.style.display = "none";
                    } else {
                        validate.textContent = "Please enter the correct format city";
                        validate.style.display = "block";
                    }
                }
                else {
                    validate.textContent = "Please enter a value";
                    validate.style.display = "block";
                }
            });

            if (city) {
                if (!cityRegex.test(city)) {
                    validate.textContent = "Please enter the correct format city";
                    validate.style.display = "block";
                    return false;
                } else {
                    validate.style.display = "none";
                    return true;
                }
            } else {
                validate.textContent = "Please enter a value";
                validate.style.display = "block";
                return false;
            }
        }

        function isStateValid(stateInput) {

            let state = stateInput.value.trim();
            let validate = stateInput.nextElementSibling;
            let stateRegex = /^[A-Z]{2}$/;

            stateInput.addEventListener("input", function () {
                state = stateInput.value.trim();
                if (state) {
                    if (stateRegex.test(state)) {
                        validate.style.display = "none";
                    } else {
                        validate.textContent = "Please enter the correct format state";
                        validate.style.display = "block";
                    }
                }
                else {
                    validate.textContent = "Please enter a value";
                    validate.style.display = "block";
                }
            });

            if (state) {
                if (!stateRegex.test(state)) {
                    validate.textContent = "Please enter the correct format state";
                    validate.style.display = "block";
                    return false;
                } else {
                    validate.style.display = "none";
                    return true;
                }
            } else {
                validate.textContent = "Please enter a value";
                validate.style.display = "block";
                return false;
            }
        }

        function isPostcode(postCodeInput) {
            let postcode = postCodeInput.value.trim();
            let validate = postCodeInput.nextElementSibling;
            let postcodeRegex = /^\d{5}$/;
            let postcodeCanRegex = /[a-zA-Z0-9]{3}\s[a-zA-Z0-9]{3}$/;

            postCodeInput.addEventListener("input", function () {
                postcode = postCodeInput.value.trim();
                if (postcode) {
                    const countryInput = document.getElementById('country');
                    const selectedCountry = countryInput.value;
                    if (selectedCountry === "United States") {
                        if (postcodeRegex.test(postcode)) {
                            validate.style.display = "none";
                        } else {
                            validate.textContent = "Please enter the correct format postcode in US";
                            validate.style.display = "block";
                        }
                    }
                    else {
                        if (postcodeCanRegex.test(postcode)) {
                            validate.style.display = "none";
                        } else {
                            validate.textContent = "Please enter the correct format postcode in CANADA";
                            validate.style.display = "block";
                        }
                    }
                }
                else {
                    validate.textContent = "Please enter a value";
                    validate.style.display = "block";
                }
            });

            if (postcode) {
                const countryInput = document.getElementById('country');
                const selectedCountry = countryInput.value;
                if (selectedCountry === "United States") {
                    if (!postcodeRegex.test(postcode)) {
                        validate.textContent = "Please enter the correct format postcode in US";
                        validate.style.display = "block";
                        return false;
                    } else {
                        validate.style.display = "none";
                        return true;
                    }
                }
                else {
                    if (postcodeCanRegex.test(postcode)) {
                        validate.style.display = "none";
                        return true;
                    } else {
                        validate.textContent = "Please enter the correct format postcode in CANADA";
                        validate.style.display = "block";
                    }
                }

            } else {
                validate.textContent = "Please enter a value";
                validate.style.display = "block";
                return false;
            }
        }

        function isCardNumberValid(cardnumberInput) {
            let cardnumberNumber = cardnumberInput.value.trim();
            let validate = cardnumberInput.nextElementSibling;
            let numberRegex = /^\d{16}$/;

            cardnumberInput.addEventListener("input", function () {
                var messageCardNumberDiv = document.getElementById("messageCardNumber");
                messageCardNumberDiv.style.display = "none";

                cardnumberNumber = cardnumberInput.value.trim();
                if (cardnumberNumber) {
                    if (numberRegex.test(cardnumberNumber)) {
                        validate.style.display = "none";
                    } else {
                        validate.textContent = "Please enter a 16-digit card number";
                        validate.style.display = "block";
                    }
                }
                else {
                    validate.textContent = "Please Enter your Card number";
                    validate.style.display = "block";
                }
            });

            if (cardnumberNumber) {
                if (numberRegex.test(cardnumberNumber)) {
                    validate.style.display = "none";
                    return true;
                } else {
                    validate.textContent = "Please enter a 16-digit card number";
                    validate.style.display = "block";
                    return false;
                }

            } else {
                validate.textContent = "Please Enter your Card number";
                validate.style.display = "block";
                return false;
            }
        }

        function isExDateValid(exDateInput) {
            let exdateNumber = exDateInput.value.trim();
            const expirationDateRow = document.getElementById('expirationDateRow');
            let validate = expirationDateRow.nextElementSibling
            let exdateRegex = /^\d{2}$/;

            exDateInput.addEventListener("input", function () {
                var messageExpiredDateDiv = document.getElementById("messageExpiredDate");
                messageExpiredDateDiv.style.display = "none";

                exdateNumber = exDateInput.value.trim();
                if (exdateNumber) {
                    if (exdateRegex.test(exdateNumber)) {
                        validate.style.display = "none";
                    } else {
                        validate.textContent = "Please enter a 2-digit Month or Year";
                        validate.style.display = "block";
                    }
                }
                else {
                    validate.textContent = "Please Enter your Expiration Date";
                    validate.style.display = "block";
                }
            });

            if (exdateNumber) {
                if (exdateRegex.test(exdateNumber)) {
                    validate.style.display = "none";
                    return true;
                } else {
                    validate.textContent = "Please enter a 2-digit Month or Year";
                    validate.style.display = "block";
                    return false;
                }

            } else {
                validate.textContent = "Please Enter your Expiration Date";
                validate.style.display = "block";
                return false;
            }
        }

        function isCardCodeValid(cardCodeInput) {
            let cardCodeNumber = cardCodeInput.value.trim();
            let validate = cardCodeInput.nextElementSibling;
            let cardCodeRegex = /^\d{3,4}$/;

            cardCodeInput.addEventListener("input", function () {
                cardCodeNumber = cardCodeInput.value.trim();
                if (cardCodeNumber) {
                    if (cardCodeRegex.test(cardCodeNumber)) {
                        validate.style.display = "none";
                    } else {
                        validate.textContent = "Please enter a 3,4-digit CVV";
                        validate.style.display = "block";
                    }
                }
                else {
                    validate.textContent = "Please Enter your CVV";
                    validate.style.display = "block";
                }
            });

            if (cardCodeNumber) {
                if (cardCodeRegex.test(cardCodeNumber)) {
                    validate.style.display = "none";
                    return true;
                } else {
                    validate.textContent = "Please enter a 3,4-digit CVV";
                    validate.style.display = "block";
                    return false;
                }

            } else {
                validate.textContent = "Please Enter your CVV";
                validate.style.display = "block";
                return false;
            }
        }

        document.addEventListener('DOMContentLoaded', function () {
            var paymentMethodRadios = document.querySelectorAll('input[name="OrderInformation.PaymentMethod"]');
            paymentMethodRadios[0].checked = true;
            for (var i = 0; i < paymentMethodRadios.length; i++) {
                paymentMethodRadios[i].addEventListener('change', function () {
                    var selectedValue = this.value;
                    document.getElementById('PaymentMethod').value = selectedValue;
                });
            }
        });

        document.addEventListener('DOMContentLoaded', function () {
            var countrySelect = document.getElementById('country');
            var postcodeInput = document.getElementById('postcode');

            countrySelect.addEventListener('change', function () {
                var selectedCountry = countrySelect.value;

                if (postcodeInput.value !== '') {
                    if (selectedCountry === 'United States' && countrySelect.getAttribute('data-last-value') === 'Canada') {
                        postcodeInput.value = '';
                    }
                }

                countrySelect.setAttribute('data-last-value', selectedCountry);
            });
        });


    </script>
}